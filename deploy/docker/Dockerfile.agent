# Build the patched runtime from the same source as the embedded chat UI.
FROM registry.cn-beijing.aliyuncs.com/mayc/node:24.18.0-bookworm-slim AS opencode-builder
RUN apt-get update && apt-get install -y --no-install-recommends git python3 make g++ ca-certificates && rm -rf /var/lib/apt/lists/*
RUN npm install -g bun@1.4.2
WORKDIR /src
COPY frontend/opencode/ ./
RUN bun install --frozen-lockfile
ARG TARGETARCH=amd64
ENV OPENCODE_CHANNEL=opsiforce OPENCODE_VERSION=0.0.0-opsiforce-model-policy-2
RUN case "$TARGETARCH" in amd64) target=linux-x64-baseline;; arm64) target=linux-arm64;; *) exit 1;; esac \
    && cd packages/cli \
    && bun run script/build.ts --target=opencode2-$target --skip-install --skip-web-ui \
    && mkdir -p /out && cp dist/cli-$target/bin/opencode2 /out/opencode2

FROM registry.cn-beijing.aliyuncs.com/mayc/golang:1.26.2-alpine AS log-writer-builder
ENV GOPROXY=https://goproxy.cn \
    GOSUMDB="sum.golang.org https://goproxy.cn/sumdb/sum.golang.org"

WORKDIR /src

COPY proxy/go.mod proxy/go.sum ./
RUN go mod download

COPY proxy/cmd/agent-log-writer ./cmd/agent-log-writer
COPY proxy/cmd/agent-control ./cmd/agent-control
ARG TARGETOS=linux
ARG TARGETARCH=amd64
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -o /out/log-writer ./cmd/agent-log-writer
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -o /out/agent-control ./cmd/agent-control

FROM registry.cn-beijing.aliyuncs.com/mayc/node:24.18.0-bookworm-slim

ARG OPENCODE_CONFIG=agent-config/opencode.json

# npm、Yarn、Node 编译头文件和 Python 包使用国内源。
ENV npm_config_registry=https://registry.npmmirror.com \
    YARN_NPM_REGISTRY_SERVER=https://registry.npmmirror.com \
    COREPACK_NPM_REGISTRY=https://registry.npmmirror.com \
    npm_config_disturl=https://npmmirror.com/mirrors/node \
    PIP_INDEX_URL=https://mirrors.tuna.tsinghua.edu.cn/pypi/web/simple \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# 同时兼容传统 sources.list 和 Debian 12 的 debian.sources。
# 精简镜像先通过国内 HTTP 源安装证书（保留 APT 签名校验），随后改用 HTTPS。
RUN set -eu; \
    for source in /etc/apt/sources.list /etc/apt/sources.list.d/*.list /etc/apt/sources.list.d/*.sources; do \
      [ -f "$source" ] || continue; \
      sed -i -e 's#https\?://deb.debian.org/debian-security#http://mirrors.tuna.tsinghua.edu.cn/debian-security#g' \
        -e 's#https\?://security.debian.org/debian-security#http://mirrors.tuna.tsinghua.edu.cn/debian-security#g' \
        -e 's#https\?://deb.debian.org/debian#http://mirrors.tuna.tsinghua.edu.cn/debian#g' "$source"; \
    done

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash git curl ca-certificates build-essential python3 unzip less \
    jq nano vim-tiny wget procps tree zip openssh-client python3-pip \
    python3-venv ffmpeg \
    sqlite3 \
    pandoc poppler-utils \
    fontconfig fonts-liberation \
    chromium \
    libnss3 libnspr4 libatk1.0-0 libatk-bridge2.0-0 libcups2 \
    libdrm2 libdbus-1-3 libxkbcommon0 libxcomposite1 libxdamage1 \
    libxfixes3 libxrandr2 libgbm1 libpango-1.0-0 libcairo2 \
    libasound2 libatspi2.0-0 libwayland-client0 \
    && rm -rf /var/lib/apt/lists/*

RUN set -eu; \
    for source in /etc/apt/sources.list /etc/apt/sources.list.d/*.list /etc/apt/sources.list.d/*.sources; do \
      [ -f "$source" ] || continue; \
      sed -i 's#http://mirrors.tuna.tsinghua.edu.cn/#https://mirrors.tuna.tsinghua.edu.cn/#g' "$source"; \
    done

RUN ln -s /usr/bin/python3 /usr/local/bin/python

RUN pip3 install --no-cache-dir --break-system-packages \
    requests Pillow datasette==1.0a28 datasette-write-ui==0.0.1a14 \
    openpyxl==3.1.5 reportlab==5.0.1 pypdf==6.16.1

RUN npm install -g bun@1.4.2 agent-browser
COPY --from=opencode-builder /out/opencode2 /usr/local/bin/opencode2

RUN mkdir -p /opt/doc-tools \
    && npm install --prefix /opt/doc-tools --no-audit --no-fund \
    docx@9.7.1 pptxgenjs@4.0.1 pdf-lib@1.17.1 \
    && ln -s /opt/doc-tools/node_modules /node_modules

# 直接复用仓库内的 Yarn，不通过 Corepack 下载。
COPY .yarn/releases/yarn-4.17.0.cjs /opt/yarn/yarn.cjs
# 在镜像内清理 Windows 换行，不依赖已有工作区是否应用了 Git 换行规则。
RUN node -e "const fs=require('fs'); for(const p of process.argv.slice(1)) fs.writeFileSync(p,fs.readFileSync(p,'utf8').replace(/\r\n/g,'\n'))" /opt/yarn/yarn.cjs \
    && chmod +x /opt/yarn/yarn.cjs \
    && ln -sf /opt/yarn/yarn.cjs /usr/local/bin/yarn \
    && ln -sf /opt/yarn/yarn.cjs /usr/local/bin/yarnpkg

# 优先使用提前下载的安装包；目录为空时从官方地址下载并有限重试。
# SHA256 来自官方 v4.117.0 发布资产，避免误装错误或不完整的包。
COPY deploy/packages/ /tmp/opsiforce-packages/
RUN set -eu; \
    deb_arch=$(dpkg --print-architecture); \
    case "$deb_arch" in \
      amd64) package_sha=0791e20168ec68dbb49db7d67369b5ea092ce2a8a262741d750e8d7947d65a3f;; \
      arm64) package_sha=88de7f01d56cdf90a06498b3710fa724ec516a532e654194d22149f75124c4f6;; \
      *) echo "code-server 不支持此架构：$deb_arch" >&2; exit 1;; \
    esac; \
    package="/tmp/opsiforce-packages/code-server_4.117.0_${deb_arch}.deb"; \
    if [ -f "$package" ]; then \
      echo "使用本地 code-server 安装包：$package"; \
    else \
      curl --fail --location --retry 3 --retry-all-errors --retry-delay 2 \
        --connect-timeout 15 --max-time 300 --retry-max-time 600 \
        --output "$package" "https://github.com/coder/code-server/releases/download/v4.117.0/code-server_4.117.0_${deb_arch}.deb" \
        || { echo 'code-server 下载失败。请在可访问 GitHub 的机器下载对应 .deb，放入 deploy/packages 后重跑构建。' >&2; exit 1; }; \
    fi; \
    printf '%s  %s\n' "$package_sha" "$package" | sha256sum -c -; \
    dpkg -i "$package"; \
    rm -rf /tmp/opsiforce-packages

RUN mkdir -p /workspace /opt/opencode /opt/agents
WORKDIR /workspace

COPY ${OPENCODE_CONFIG} /opt/opencode/opencode.json
COPY agent-config/models.json /opt/opencode/models.json

COPY agent-config/ /opt/agent-config-src/
ENV OPENCODE_MODELS_PATH=/opt/opencode/models.json OPENCODE_DISABLE_MODELS_FETCH=true
RUN cp -a /opt/agent-config-src/agents/. /opt/agents/ \
    && if [ -d /opt/agent-config-src/private/agents ]; then cp -a /opt/agent-config-src/private/agents/. /opt/agents/; fi \
    && node /opt/agent-config-src/scripts/compose-skills.mjs /opt/agent-config-src/skills /opt/agents \
    && node /opt/agent-config-src/scripts/merge-registry.mjs /opt/agent-config-src/agents.json /opt/agent-config-src/private/agents.json /opt/agents/agents.json \
    && rm -rf /opt/agent-config-src /opt/agents/.gitkeep

COPY agent-config/scripts/guard.sh /usr/local/bin/guard
COPY agent-config/runtime/ /opt/opsiforce-runtime/
RUN node -e "const fs=require('fs'); const p='/opt/opsiforce-runtime/cli.mjs'; fs.writeFileSync(p,fs.readFileSync(p,'utf8').replace(/\r\n/g,'\n'))" \
    && chmod +x /opt/opsiforce-runtime/cli.mjs \
    && ln -s /opt/opsiforce-runtime/cli.mjs /usr/local/bin/opsiforce-runtime
COPY agent-config/scripts/entrypoint.sh /usr/local/bin/entrypoint.sh
COPY agent-config/scripts/agent-workspace-migrate.mjs /usr/local/bin/agent-workspace-migrate
COPY agent-config/datasette-metadata.yml /opt/opencode/datasette-metadata.yml
# 这些脚本也通过 shebang 启动，统一清理 CRLF 后再设置可执行权限。
RUN node -e "const fs=require('fs'); for(const p of process.argv.slice(1)) fs.writeFileSync(p,fs.readFileSync(p,'utf8').replace(/\r\n/g,'\n'))" \
    /usr/local/bin/guard /usr/local/bin/entrypoint.sh /usr/local/bin/agent-workspace-migrate \
    && chmod +x /usr/local/bin/guard /usr/local/bin/entrypoint.sh /usr/local/bin/agent-workspace-migrate

RUN apt-get update && apt-get install -y --no-install-recommends \
    ripgrep file \
    && rm -rf /var/lib/apt/lists/*

COPY --from=log-writer-builder /out/log-writer /usr/local/bin/log-writer
COPY --from=log-writer-builder /out/agent-control /usr/local/bin/agent-control
RUN chmod +x /usr/local/bin/log-writer /usr/local/bin/agent-control

ENV NODE_OPTIONS=--max-http-header-size=131072 OPENCODE_DISABLE_CHANNEL_DB=true

HEALTHCHECK --interval=10s --timeout=3s --start-period=30s \
  CMD wget -q --spider http://localhost:4096/api/health || exit 1

EXPOSE 4096 3000 8080 8081 4910

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]

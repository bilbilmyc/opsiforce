# syntax=registry.cn-beijing.aliyuncs.com/mayc/dockerfile:1
FROM registry.cn-beijing.aliyuncs.com/mayc/golang:1.26.2-alpine AS builder
WORKDIR /src
COPY proxy/go.mod proxy/go.sum ./
RUN go mod download
COPY proxy/ ./
ARG TARGETOS=linux
ARG TARGETARCH=amd64
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -trimpath -ldflags="-s -w" -o /out/opsiforce-proxy ./cmd/opsiforce-proxy

FROM registry.cn-beijing.aliyuncs.com/mayc/alpine:3.22
RUN apk add --no-cache ca-certificates
COPY --from=builder /out/opsiforce-proxy /usr/local/bin/opsiforce-proxy
EXPOSE 3002 3003 3004 3005
ENTRYPOINT ["/usr/local/bin/opsiforce-proxy"]

{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "app-builder",
  "provider": {
    "anthropic": {
      "models": {
        "claude-opus-4-6": {},
        "claude-sonnet-4-6": {},
        "claude-haiku-4-5": {}
      }
    },
    "openai": {
      "models": {
        "gpt-5.3-codex": {
          "options": {
            "reasoningEffort": "high"
          }
        },
        "o4-mini": {
          "options": {
            "reasoningEffort": "high"
          }
        },
        "gpt-5.4-mini": {
          "options": {
            "reasoningEffort": "high"
          }
        },
        "gpt-5.4-nano": {}
      }
    }
  },
  "model": "openai/gpt-5.3-codex",
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": "allow",
    "task": "allow",
    "todowrite": "allow",
    "todoread": "allow",
    "mcp": "allow",
    "external_directory": "allow",
    "websearch": "allow",
    "question": "allow",
    "skill": "allow"
  }
}

{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["opencode-large-image-optimizer"],
  "default_agent": "app-builder",
  "provider": {
    "anthropic": {
      "models": {
        "claude-opus-4-7": {
          "options": {
            "reasoningEffort": "high"
          }
        },
        "claude-sonnet-4-6": {
          "options": {
            "reasoningEffort": "high"
          }
        },
        "claude-haiku-4-5": {}
      }
    },
    "openai": {
      "models": {
        "gpt-5.4": {
          "options": {
            "reasoningEffort": "high"
          }
        },
        "gpt-5.4-mini": {
          "options": {
            "reasoningEffort": "high"
          }
        },
        "gpt-5.3-codex": {
          "options": {
            "reasoningEffort": "high"
          }
        }
      }
    }
  },
  "model": "openai/gpt-5.4",
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": "allow",
    "task": "allow",
    "todowrite": "allow",
    "todoread": "allow",
    "mcp": "allow",
    "external_directory": "allow",
    "websearch": "allow",
    "question": "allow",
    "skill": "allow"
  }
}

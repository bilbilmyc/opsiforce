{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["opencode-large-image-optimizer"],
  "default_agent": "app-builder",
  "agent": {
    "build": {
      "disable": true
    }
  },
  "disabled_providers": ["opencode"],
  "provider": {
    "anthropic": {
      "whitelist": ["claude-opus-4-8", "claude-opus-4-7", "claude-sonnet-4-6", "claude-haiku-4-5"],
      "models": {
        "claude-opus-4-8": {
          "options": {
            "reasoningEffort": "high"
          }
        },
        "claude-opus-4-7": {
          "options": {
            "reasoningEffort": "high"
          }
        },
        "claude-sonnet-4-6": {
          "options": {
            "reasoningEffort": "high"
          }
        },
        "claude-haiku-4-5": {}
      }
    },
    "openai": {
      "whitelist": ["gpt-5.5", "gpt-5.4", "gpt-5.4-mini"],
      "models": {
        "gpt-5.5": {
          "limit": { "context": 290400, "output": 32000 },
          "options": {
            "reasoningEffort": "high"
          }
        },
        "gpt-5.4": {
          "limit": { "context": 290400, "output": 32000 },
          "options": {
            "reasoningEffort": "high"
          }
        },
        "gpt-5.4-mini": {
          "limit": { "context": 290400, "output": 32000 },
          "options": {
            "reasoningEffort": "high"
          }
        }
      }
    }
  },
  "model": "openai/gpt-5.5",
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": "allow",
    "task": "allow",
    "todowrite": "allow",
    "todoread": "allow",
    "mcp": "allow",
    "external_directory": "allow",
    "websearch": "allow",
    "question": "allow",
    "skill": "allow"
  }
}

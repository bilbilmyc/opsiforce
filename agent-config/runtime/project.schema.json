{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Opsiforce startup-script manifest (phase 1a)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "recipe", "startup"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
        "version": { "type": "string", "pattern": "^[0-9]{1,8}$" }
      }
    },
    "startup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["script", "cwd"],
      "properties": {
        "script": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "cwd": { "type": "string", "minLength": 1, "maxLength": 1024 }
      }
    }
  }
}

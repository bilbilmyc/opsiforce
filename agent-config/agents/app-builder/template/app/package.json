{
  "name": "opsiforce-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"bun run dev:backend\" \"bun run dev:frontend\"",
    "dev:frontend": "vite frontend --host 0.0.0.0",
    "dev:backend": "nest start --watch --path backend/tsconfig.json",
    "build": "vite build frontend && tsc -p backend/tsconfig.json",
    "check": "tsc --noEmit -p frontend/tsconfig.json 2>&1 | head -20; tsc --noEmit -p backend/tsconfig.json 2>&1 | head -20",
    "db:migrate": "tsx backend/src/database/migrate.ts"
  },

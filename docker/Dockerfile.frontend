FROM node:24-alpine AS builder

WORKDIR /app

COPY package.json yarn.lock .yarnrc.yml ./
COPY .yarn ./.yarn
COPY packages/opsiforce/frontend ./packages/opsiforce/frontend
COPY packages/opsiforce/opencode ./packages/opsiforce/opencode

RUN yarn workspaces focus --all

WORKDIR /app/packages/opsiforce/frontend

RUN yarn build

FROM nginx:alpine

COPY --from=builder /app/packages/opsiforce/frontend/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
